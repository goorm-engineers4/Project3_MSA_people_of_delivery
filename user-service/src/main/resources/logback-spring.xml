<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">
    <springProperty scope="context" name="APP_NAME" source="spring.application.name"/>

    <!-- 공통: 콘솔 appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- 🟡 traceId 추가 -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [%X{traceId}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- !prod 환경: 콘솔만 사용 -->
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <logger name="com.example.cloudfour" level="DEBUG"/>
        <logger name="org.springframework.web" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE"/>
    </springProfile>

    <!-- prod 환경: 파일 + 콘솔 -->
    <springProfile name="prod">
        <!-- 파일 appender (JSON 포맷 + traceId 포함) -->
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>user-service/logs/${APP_NAME}.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>user-service/${APP_NAME}.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            </rollingPolicy>
            <encoder>
                <!-- 🟡 traceId JSON 필드로 추가 -->
                <pattern>{
                    "ts":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ}",
                    "level":"%level",
                    "service":"${APP_NAME}",
                    "traceId":"%X{traceId}",
                    "thread":"%thread",
                    "logger":"%logger",
                    "msg":"%replace(%msg){'\n','\\n'}"
                    }%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <!-- 비동기 파일 appender -->
        <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="FILE"/>
        </appender>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>

        <logger name="com.example.cloudfour" level="WARN"/>
        <logger name="org.springframework.web" level="WARN"/>
    </springProfile>
</configuration>